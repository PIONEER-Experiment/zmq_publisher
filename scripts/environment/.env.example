# Copy this file to .env.local and edit the paths for this machine.
# setup_env.sh creates that copy automatically and never overwrites it.

# Required by --with-midas and --with-gaudi.
export MIDASSYS=/path/to/midas

# Optional local source override. If omitted, the build uses ../midas_receiver.
export MIDAS_RECEIVER_SOURCE=/path/to/midas_receiver

# Required only to build or run the PIONEER Gaudi online sidecar.
export PIONEER_SOURCE_DIR=/path/to/PIONEER
export PIONEER_GAUDI_IMAGE=/path/to/pioneer-gaudi.sif

# Runtime experiment selection is normally supplied by the demo launcher.
# Set these only when connecting manually to an existing experiment.
# export MIDAS_EXPTAB=/path/to/exptab
# export MIDAS_EXPT_NAME=experiment-name
