{
  "general-settings": {
    "verbose": 1,
    "worker-threads": 2,
    "transport": {
      "worker-threads": 1,
      "zmq-io-threads": 1,
      "queue-capacity": 1024,
      "queue-policy": "block"
    },
    "telemetry": {
      "enabled": true,
      "interval-ms": 1000,
      "endpoint": "",
      "topic": "METRICS"
    },
    "processor-extensions": [
      "build/lib/libzmq_publisher_command_extension.so"
    ]
  },
  "data-channels": {
    "system-time": {
      "enabled": true,
      "endpoint": "tcp://127.0.0.1:5555",
      "topic": "TIME",
      "delivery": {
        "mode": "each"
      },
      "processors": [
        {
          "type": "command",
          "schedule": {
            "mode": "fixed-delay",
            "interval-ms": 1000
          },
          "config": {
            "command": [
              "/bin/date",
              "--iso-8601=seconds"
            ]
          }
        }
      ]
    }
  }
}
