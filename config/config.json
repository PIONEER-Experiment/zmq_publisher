{
  "general-settings": {
    "verbose": 1,
    "worker-threads": 2,
    "output-queue-capacity": 1024,
    "processor-extensions": [
      "build/lib/libzmq_publisher_command_extension.so"
    ]
  },
  "data-channels": {
    "system-time": {
      "enabled": true,
      "endpoint": "tcp://127.0.0.1:5555",
      "topic": "TIME",
      "publishes-per-batch": 1,
      "publishes-ignored-after-batch": 0,
      "buffer-capacity": 1,
      "processors": [
        {
          "type": "command",
          "schedule": {
            "mode": "fixed-delay",
            "interval-ms": 1000
          },
          "config": {
            "command": [
              "/bin/date",
              "--iso-8601=seconds"
            ]
          }
        }
      ]
    }
  }
}
