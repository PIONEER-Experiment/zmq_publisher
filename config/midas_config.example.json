{
  "general-settings": {
    "verbose": 1,
    "worker-threads": 2,
    "transport": {
      "worker-threads": 1,
      "zmq-io-threads": 1,
      "queue-capacity": 4096,
      "queue-policy": "block"
    },
    "telemetry": {
      "enabled": true,
      "interval-ms": 1000,
      "endpoint": "tcp://127.0.0.1:5556",
      "topic": "METRICS"
    },
    "processor-extensions": [
      "build/lib/libzmq_publisher_midas_extension.so"
    ]
  },
  "data-channels": {
    "midas-events": {
      "enabled": true,
      "endpoint": "tcp://127.0.0.1:5555",
      "topic": "DATA",
      "delivery": {
        "mode": "each"
      },
      "processors": [
        {
          "type": "midas",
          "schedule": {
            "mode": "continuous",
            "idle-backoff-us": 0
          },
          "config": {
            "host": "",
            "experiment": "",
            "buffer": "SYSTEM",
            "client-name": "ZmqPublisher",
            "event-id": -1,
            "get-all": true,
            "buffer-size": 1000,
            "yield-timeout-ms": 300,
            "num-events-per-retrieval": 1
          }
        }
      ]
    }
  }
}
